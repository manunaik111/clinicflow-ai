# ClinicFlow AI configuration template
# 1. Copy this file and name the copy exactly:  .env
# 2. Replace the placeholder values with your real keys
# 3. NEVER commit the real .env file (it is blocked by .gitignore)

# --- API keys ---
GROQ_API_KEY=your-groq-api-key-here

# --- Model names (check your provider's docs if a name stops working) ---
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_MODEL=llama-3.3-70b-versatile

# --- App settings ---
DATABASE_PATH=clinicflow.db
CHROMA_DIR=chroma_db
BACKEND_URL=http://127.0.0.1:8000
